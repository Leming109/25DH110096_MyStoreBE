
@model _25DH110096_MyStoreBE.Models.Product

@{
    string defaultImage = Url.Content("~/Content/images/default_img.png");

    string currentImage = defaultImage;

    if (Model != null && !String.IsNullOrWhiteSpace(Model.ProductImage))
    {
        currentImage = Model.ProductImage.StartsWith("~/")
            ? Url.Content(Model.ProductImage)
            : Model.ProductImage;
    }
}

<style>
    .product-form-group {
        margin-bottom: 18px;
    }

        .product-form-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 7px;
            color: #444;
        }

        .product-form-group .form-control {
            width: 100%;
            border: 1px solid #ccc;
            border-radius: 4px;
            padding: 9px 12px;
        }

        .product-form-group textarea {
            min-height: 120px;
            resize: vertical;
        }

    .product-image-preview {
        display: block;
        width: 180px;
        height: 180px;
        object-fit: contain;
        border: 1px solid #ddd;
        border-radius: 5px;
        padding: 5px;
        margin-top: 12px;
        background: #fff;
    }

    .product-form-note {
        color: #888;
        font-size: 12px;
        margin-top: 6px;
    }

    .text-danger {
        display: block;
        margin-top: 5px;
    }
</style>

<div class="product-form-group">

    @Html.LabelFor(model => model.CategoryID, "Danh mục")

    @Html.DropDownListFor(
            model => model.CategoryID,
            (SelectList)ViewBag.CategoryID,
            "-- Chọn danh mục --",
            new { @class = "form-control" }
        )

    @Html.ValidationMessageFor(
            model => model.CategoryID,
            "",
            new { @class = "text-danger" }
        )

</div>


<div class="product-form-group">

    @Html.LabelFor(model => model.ProductName, "Tên sản phẩm")

    @Html.TextBoxFor(
            model => model.ProductName,
            new
            {
                @class = "form-control",
                placeholder = "Nhập tên sản phẩm..."
            }
        )

    @Html.ValidationMessageFor(
            model => model.ProductName,
            "",
            new { @class = "text-danger" }
        )

</div>

<div class="product-form-group">

    @Html.LabelFor(model => model.ProductDecription, "Mô tả sản phẩm")

    @Html.TextAreaFor(
            model => model.ProductDecription,
            new
            {
                @class = "form-control",
                placeholder = "Nhập mô tả sản phẩm...",
                rows = "5"
            }
        )

    @Html.ValidationMessageFor(
            model => model.ProductDecription,
            "",
            new { @class = "text-danger" }
        )

</div>

<div class="product-form-group">

    @Html.LabelFor(model => model.ProductPrice, "Đơn giá (VND)")

    @Html.TextBoxFor(
            model => model.ProductPrice,
            "{0:0.##}",
            new
            {
                @class = "form-control",
                type = "number",
                min = "0",
                step = "0.01",
                placeholder = "Nhập giá sản phẩm..."
            }
        )

    @Html.ValidationMessageFor(
            model => model.ProductPrice,
            "",
            new { @class = "text-danger" }
        )

</div>
<div class="product-form-group">

    @Html.LabelFor(model => model.ProductImage, "Link hình ảnh sản phẩm")

    @Html.TextBoxFor(
            model => model.ProductImage,
            new
            {
                @class = "form-control",
                placeholder = "https://example.com/image.jpg",
                autocomplete = "off",
                id = "ProductImage"
            }
        )

    @Html.ValidationMessageFor(
            model => model.ProductImage,
            "",
            new { @class = "text-danger" }
        )

    <p class="product-form-note">
        Dán đường dẫn ảnh trực tiếp (URL) vào ô trên để hiển thị hình ảnh.
    </p>
    <img id="productImagePreview"
         src="@currentImage"
         data-default-image="@defaultImage"
         data-app-root="@Url.Content("~/")"
         class="product-image-preview"
         alt="Ảnh xem trước sản phẩm" />

</div>
<script>
    (function () {

        var imageInput = document.getElementById("ProductImage");
        var imagePreview = document.getElementById("productImagePreview");

        if (!imageInput || !imagePreview) {
            return;
        }

        var defaultImage = imagePreview.getAttribute("data-default-image");
        var appRoot = imagePreview.getAttribute("data-app-root");

        function updateImagePreview() {

            var imageUrl = imageInput.value.trim();

            if (imageUrl === "") {
                imagePreview.src = defaultImage;
                return;
            }
            if (imageUrl.indexOf("~/") === 0) {
                imageUrl = appRoot + imageUrl.substring(2);
            }

            imagePreview.src = imageUrl;
        }

        imageInput.addEventListener("input", updateImagePreview);

        imagePreview.addEventListener("error", function () {
            this.src = defaultImage;
        });

    })();
</script>
