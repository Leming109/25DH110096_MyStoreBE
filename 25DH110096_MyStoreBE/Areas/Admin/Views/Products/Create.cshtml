
@model _25DH110096_MyStoreBE.Models.Product

@{
    ViewBag.Title = "Thêm hàng hóa";
    Layout = "~/Areas/Admin/Views/Shared/_AdminsLayout.cshtml";
}

<style>
    .product-create {
        max-width: 850px;
        margin: 20px auto;
        padding: 25px;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 6px;
    }

        .product-create h2 {
            color: #b72e3c;
            font-size: 23px;
            font-weight: bold;
            margin-bottom: 25px;
            padding-bottom: 12px;
            border-bottom: 2px solid #b72e3c;
        }

        .product-create .form-actions {
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid #eee;
        }

    .btn-submit {
        background: #b72e3c;
        color: white;
        border: none;
        padding: 9px 18px;
        border-radius: 4px;
    }

        .btn-submit:hover {
            background: #922431;
            color: white;
        }

    .btn-back {
        display: inline-block;
        padding: 9px 18px;
        background: #eee;
        color: #333;
        text-decoration: none;
        border-radius: 4px;
    }
</style>

<div class="product-create">

    <h2>THÊM HÀNG HÓA MỚI</h2>

    @using (Html.BeginForm(
        "Create",
        "Products",
        FormMethod.Post,
        new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">

            @Html.ValidationSummary(
                     true,
                     "",
                     new { @class = "text-danger" }
                 )

            @Html.Partial(
                     "PartialView_Products",
                     Model ?? new _25DH110096_MyStoreBE.Models.Product()
                 )

            <div class="form-actions">

                <input type="submit"
                       value="Thêm hàng hóa"
                       class="btn-submit" />

                @Html.ActionLink(
                         "Quay lại",
                         "Index",
                         null,
                         new { @class = "btn-back" }
                     )

            </div>

        </div>
    }
</div>
@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
