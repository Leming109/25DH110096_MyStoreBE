
@model _25DH110096_MyStoreBE.Models.ViewModels.SearchProductVM

@using PagedList.Mvc;
@using System.Linq;
@using System.Globalization;

<style>
    .product-list {
        margin-top: 20px;
        width: 100%;
    }

    .product-list-title {
        font-size: 20px;
        font-weight: bold;
        color: #333;
        margin-bottom: 15px;
    }

    .product-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        border: 1px solid #ddd;
    }

        .product-table th {
            background: #b72e3c;
            color: white;
            padding: 13px 10px;
            text-align: left;
            font-size: 14px;
        }

        .product-table td {
            padding: 12px 10px;
            border-bottom: 1px solid #eee;
            vertical-align: middle;
            font-size: 14px;
        }

        .product-table tr:hover {
            background: #fff8f8;
        }

    .product-image {
        width: 65px;
        height: 65px;
        object-fit: contain;
        border: 1px solid #eee;
        border-radius: 4px;
        background: white;
    }

    .product-name {
        font-weight: 600;
        color: #333;
    }

    .product-price {
        color: #b72e3c;
        font-weight: bold;
        white-space: nowrap;
    }

    .product-category {
        display: inline-block;
        background: #f5eeee;
        color: #a52b38;
        padding: 5px 10px;
        border-radius: 4px;
    }

    .product-actions {
        white-space: nowrap;
    }

    .btn-product {
        display: inline-block;
        padding: 6px 10px;
        margin: 2px;
        border-radius: 4px;
        text-decoration: none !important;
        font-size: 12px;
    }

    .btn-edit {
        background: #eee;
        color: #333 !important;
    }

    .btn-detail {
        background: #e8f0fa;
        color: #245a91 !important;
    }

    .btn-delete {
        background: #fbecee;
        color: #b72e3c !important;
    }

    .btn-edit:hover {
        background: #ddd;
    }

    .btn-detail:hover {
        background: #d4e3f5;
    }

    .btn-delete:hover {
        background: #b72e3c;
        color: white !important;
    }

    .product-empty {
        padding: 30px !important;
        text-align: center;
        color: #888;
    }

    .pagination-container {
        margin-top: 20px;
        text-align: center;
    }

    .stock-unavailable {
        color: #999;
        font-size: 12px;
    }

    @@media(max-width: 768px) {
        .product-table-wrapper {
            overflow-x: auto;
        }

        .product-table {
            min-width: 850px;
        }
    }
</style>

<div class="product-list">

    <h3 class="product-list-title">
        DANH SÁCH HÀNG HÓA
    </h3>

    <div class="product-table-wrapper">

        <table class="product-table">

            <thead>
                <tr>
                    <th style="width: 12%;">Hình ảnh</th>
                    <th style="width: 23%;">Tên hàng hóa</th>
                    <th style="width: 17%;">Giá bán</th>
                    <th style="width: 13%;">Số lượng tồn</th>
                    <th style="width: 15%;">Chủng loại</th>
                    <th style="width: 20%;">Thao tác</th>
                </tr>
            </thead>
                @if (Model.Products != null && Model.Products.Any())
                {
                    foreach (var item in Model.Products)
                    {
                        string imageUrl = String.IsNullOrWhiteSpace(item.ProductImage)
                            ? Url.Content("~/Content/images/default_img.png")
                            : Url.Content(item.ProductImage);

                        <tr>
                            <td>
                                <img src="@imageUrl"
                                     class="product-image"
                                     alt="@item.ProductName"
                                     onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/default_img.png")';" />
                            </td>
                            <td>
                                <span class="product-name">
                                    @item.ProductName
                                </span>
                            </td>
                            <td>
                                <span class="product-price">
                                    @item.ProductPrice.ToString("N0", new CultureInfo("vi-VN")) ₫
                                </span>
                            </td>

                            <td>
                                <span class="stock-unavailable">
                                    Chưa có dữ liệu
                                </span>
                            </td>
                            <td>
                                <span class="product-category">
                                    @(item.Category != null
                                        ? item.Category.CategoryName
                                        : "Chưa phân loại")
                                </span>
                            </td>
                            <td class="product-actions">

                                @Html.ActionLink(
                                         "Sửa",
                                         "Edit",
                                         new { id = item.ProductID },
                                         new { @class = "btn-product btn-edit" }
                                     )

                                @Html.ActionLink(
                                         "Chi tiết",
                                         "Details",
                                         new { id = item.ProductID },
                                         new { @class = "btn-product btn-detail" }
                                     )

                                @Html.ActionLink(
                                         "Xóa",
                                         "Delete",
                                         new { id = item.ProductID },
                                         new { @class = "btn-product btn-delete" }
                                     )

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="product-empty">
                            Không tìm thấy sản phẩm nào phù hợp.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>
    @if (Model.Products != null && Model.Products.Any())
    {
        <div class="pagination-container">

            @Html.PagedListPager(
                     Model.Products,
                     page => Url.Action("Index", new
                     {
                         page = page,
                         searchTerm = Model.SearchTerm,
                         minPrice = Model.MinPrice,
                         maxPrice = Model.MaxPrice,
                         sortOrder = Model.SortOrder
                     })
                 )

        </div>
    }
</div>
