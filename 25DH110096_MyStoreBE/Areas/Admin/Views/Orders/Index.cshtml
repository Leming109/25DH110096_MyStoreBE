
@model PagedList.IPagedList<_25DH110096_MyStoreBE.Models.Order>

@using PagedList.Mvc;
@using System;
@using System.Globalization;
@using System.Linq;

@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminsLayout.cshtml";

    string customerName = ViewBag.CustomerName as string ?? "";
    string selectedDate = ViewBag.OrderDate as string ?? "";
}

<style>
    .order-page {
        padding: 5px 0 25px;
    }

    .order-title {
        background: #dff0d8;
        padding: 5px;
        font-size: 30px;
        margin: 0 0 20px;
        color: #333;
    }

    .order-search {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr auto;
        gap: 20px;
        align-items: end;
        margin-bottom: 25px;
        padding: 5px 15px;
    }

        .order-search label {
            display: block;
            font-weight: normal;
            margin-bottom: 17px;
        }

        .order-search input,
        .order-search select {
            width: 100%;
            height: 36px;
            padding: 5px;
            border: 1px solid #aaa;
            border-radius: 3px;
        }

    .btn-search-order {
        background: #337ab7;
        color: white;
        border: none;
        padding: 9px 17px;
        border-radius: 4px;
        margin-bottom: 0;
    }

        .btn-search-order:hover {
            background: #286090;
        }

    .order-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
    }

        .order-table th {
            padding: 12px 10px;
            background: #dff0d8;
            border: 1px solid #ddd;
            text-align: left;
            color: #333;
        }

        .order-table td {
            padding: 12px 10px;
            border: 1px solid #d5e3e9;
            background: #d9edf7;
            vertical-align: middle;
        }

        .order-table tr:hover td {
            background: #cce5f2;
        }

    .order-link {
        color: #337ab7;
        text-decoration: none;
        white-space: nowrap;
    }

        .order-link:hover {
            color: #23527c;
            text-decoration: underline;
        }

    .order-total {
        white-space: nowrap;
        font-weight: 600;
    }

    .order-status {
        color: #333;
    }

    .order-empty {
        text-align: center;
        padding: 25px !important;
    }

    .order-pagination {
        margin-top: 15px;
    }

    @@media(max-width: 768px) {
        .order-search {
            grid-template-columns: 1fr;
            gap: 12px;
        }

            .order-search label {
                margin-bottom: 5px;
            }

        .order-table-wrapper {
            overflow-x: auto;
        }

        .order-table {
            min-width: 950px;
        }
    }
</style>

<div class="order-page">

    <!-- TÌM KIẾM ĐƠN HÀNG -->
    @using (Html.BeginForm("Index", "Orders", FormMethod.Get))
    {
        <div class="order-search">

            <div>
                <label>Tên khách hàng</label>

                @Html.TextBox(
                         "customerName",
                         customerName,
                         new
                         {
                             placeholder = "Nhập tên khách hàng..."
                         })
            </div>

            <div>
                <label>Trạng thái thanh toán</label>

                @Html.DropDownList(
                         "paymentStatus",
                         (SelectList)ViewBag.PaymentStatuses,
                         "Tất cả trạng thái",
                         new { })
            </div>

            <div>
                <label>Ngày đặt hàng</label>

                <input type="date"
                       name="orderDate"
                       value="@selectedDate" />
            </div>

            <div>
                <button type="submit" class="btn-search-order">
                    Tìm kiếm
                </button>
            </div>

        </div>
    }

    <!-- TIÊU ĐỀ -->
    <h2 class="order-title">
        DANH SÁCH ĐƠN HÀNG
    </h2>

    <!-- BẢNG ĐƠN HÀNG -->
    <div class="order-table-wrapper">

        <table class="order-table">

            <thead>
                <tr>
                    <th>Ngày đặt hàng</th>
                    <th>Tên khách hàng</th>
                    <th>Tổng giá trị</th>
                    <th>Trạng thái thanh toán</th>
                    <th>Phương thức giao hàng</th>
                    <th>Chi tiết</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        string orderDateText =
                            item.OrderDate == DateTime.MinValue
                            ? "Chưa xác định"
                            : item.OrderDate.ToString("dd/MM/yyyy HH:mm");

                        <tr>

                            <td>
                                @orderDateText
                            </td>

                            <td>
                                @(item.Customer != null
                                    ? item.Customer.CustomerName
                                    : "Không xác định")
                            </td>

                            <td class="order-total">
                                @item.TotalAmount.ToString(
                                         "N0",
                                         CultureInfo.GetCultureInfo("vi-VN")
                                     ) ₫
                            </td>

                            <td class="order-status">
                                @(String.IsNullOrWhiteSpace(item.PaymentStatus)
                                    ? "Chưa xác định"
                                    : item.PaymentStatus)
                            </td>

                            <td>
                                @(String.IsNullOrWhiteSpace(item.ShippingMethod)
                                    ? "Chưa xác định"
                                    : item.ShippingMethod)
                            </td>

                            <td>
                                @Html.ActionLink(
                                         "Chi tiết đơn hàng",
                                         "Details",
                                         new { id = item.OrderID },
                                         new { @class = "order-link" }
                                     )
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="order-empty">
                            Không tìm thấy đơn hàng nào.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

    <!-- PHÂN TRANG -->
    @if (Model != null && Model.PageCount > 1)
    {
        <div class="order-pagination">

            @Html.PagedListPager(
                     Model,
                     page => Url.Action("Index", new
                     {
                         page = page,
                         customerName = customerName,
                         paymentStatus = ViewBag.SelectedPaymentStatus,
                         orderDate = selectedDate
                     })
                 )

        </div>
    }

</div>
